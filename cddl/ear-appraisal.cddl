;# import ar4si as ar4si
;# import rfc9711 as eat

EAR-appraisal = {
  ? eat.profile-label => eat.general-uri / eat.general-oid
  status-label => ar4si.trustworthiness-tier
  ? status-details-label => details-type
  ? trustworthiness-vector-label => ar4si.trustworthiness-vector
  ? trustworthiness-vector-details-label => trustworthiness-vector-details
  ? appraisal-policy-ids-label => [ + text ]
  ? eat.nonce-label => eat.nonce-type
  ? attester-claims-label => claims-map-type
  ? verifier-claims-label => claims-map-type
  ? endorser-claims-label => supply-chain-claims-type
  ? reference-value-provider-claims-label => supply-chain-claims-type
  * $$ear-appraisal-extension
}

status-label = eat.JC<"ear_status", 1000>
trustworthiness-vector-label = eat.JC<"ear_trustworthiness_vector", 1001>
status-details-label = eat.JC<"ear_status_details", 1010>
trustworthiness-vector-details-label =
  eat.JC<"ear_trustworthiness_vector_details", 1011>

details-type = [ + text ]

trustworthiness-vector-details = ar4si.non-empty<{
  ? ar4si.instance-identity-label => details-type,
  ? ar4si.configuration-label => details-type,
  ? ar4si.executables-label => details-type,
  ? ar4si.file-system-label => details-type,
  ? ar4si.hardware-label => details-type,
  ? ar4si.runtime-opaque-label => details-type,
  ? ar4si.storage-opaque-label => details-type,
  ? ar4si.sourced-data-label => details-type,
}>
appraisal-policy-ids-label = eat.JC<"ear_appraisal_policy_ids", 1003>
attester-claims-label = eat.JC<"ear_attester_claims", 1005>
verifier-claims-label = eat.JC<"ear_verifier_claims", 1006>
endorser-claims-label = eat.JC<"ear_endorser_claims", 1008>
reference-value-provider-claims-label = eat.JC<"ear_reference_value_provider_claims", 1009>

; supply chain entity name => claims it asserted
supply-chain-claims-type = { + text => claims-map-type }
