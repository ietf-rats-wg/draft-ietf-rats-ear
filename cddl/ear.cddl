;# import rfc9711 as eat
;# import ar4si as ar4si
;# import cmw as cmw

EAR = {
  eat.profile-label => "tag:ietf.org,2026:rats/ear#05"
  ? status-label => ar4si.trustworthiness-tier
  eat.iat-claim-label => ~eat.time-int
  ? eat.exp-claim-label => ~eat.time-int
  verifier-id-label => ar4si.verifier-id
  ? raw-evidence-label => cmw-record
  eat.submods-label => { + text => $submod-value }
  ? eat.nonce-label => eat.nonce-type
  ? topology-label => topology-type
  * $$ear-extension
}

cmw-record = eat.JC<cmw.json-record, cmw.cbor-record>

; A submod carries one of:
;  - EAR-appraisal: the appraisal of a single attester;
;  - EAR: an unsigned EAR claims-set from a sub-verifier, in the same
;    serialization as the enclosing token;
;  - eat.Nested-Token: a complete, signed EAR from a sub-verifier, possibly
;    in a different serialization than the enclosing token (see
;    Section 4.2.18.3 of RFC 9711 for how the nested token is identified).
$submod-value /= EAR-appraisal
$submod-value /= EAR
$submod-value /= eat.Nested-Token

; EAR-specific claims
raw-evidence-label = eat.JC<"ear_raw_evidence", 1002>
verifier-id-label = eat.JC<"ear_verifier_id", 1004>
topology-label = eat.JC<"ear_device_topology", 1007>
