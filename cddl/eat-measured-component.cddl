;# import rfc9711 as eat

; The digest type (Section 4.2 of I-D.ietf-rats-eat-measured-component).
; alg is either an "ID" (int) or a "Hash Name String" (text) from the
; "Named Information Hash Algorithm" Registry [IANA.named-information].
digest = [
  alg: (int / text)
  val: digest-value-type
]

digest-value-type = eat.JC<bytes-b64u, bytes>

; Common type (Section 4.1 of I-D.ietf-rats-eat-measured-component).
bytes-b64u = text .b64u bytes
