;# import rfc9711 as eat

; Public keys published by the attested environment, to which a Relying Party
; can wrap a secret.
secret-wrapping-keys-type = eat.JC<jwk-set, cose-key-set>

; Section 5 of RFC 7517
jwk-set = { "keys": [ + jwk ] }
jwk = { "kty": text, * text => any }

; Section 7 of RFC 9052
cose-key-set = [ + cose-key ]
cose-key = { 1 => int / tstr, * (int / tstr) => any }
